{
  "$defs": {
    "WorkspaceResourceKind": {
      "description": "The workspace resources the Web observer can invalidate.",
      "enum": [
        "overview",
        "target",
        "service",
        "issue",
        "investigation",
        "evidence"
      ],
      "title": "WorkspaceResourceKind",
      "type": "string"
    }
  },
  "$id": "incidentlens://protocol/workspace-stream-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Minimal invalidation envelope forwarded as SSE ``data:``.",
  "properties": {
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "const": "resource.changed",
      "default": "resource.changed",
      "title": "Event Type",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "resource_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resource Id"
    },
    "resource_kind": {
      "$ref": "#/$defs/WorkspaceResourceKind"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "service_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Service Id"
    },
    "target_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Id"
    }
  },
  "required": [
    "event_id",
    "occurred_at",
    "resource_kind",
    "schema_version"
  ],
  "title": "WorkspaceResourceChanged",
  "type": "object"
}
