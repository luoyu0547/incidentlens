{
  "$id": "incidentlens://protocol/cli-stream-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string"
    },
    "event_type": {
      "minLength": 1,
      "type": "string"
    },
    "payload": {
      "type": "object"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "sequence": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "event_type",
    "sequence"
  ],
  "title": "cli-stream-v1",
  "type": "object"
}
