  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
