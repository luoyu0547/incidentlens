{
  "name": "@incidentlens/cli",
  "version": "0.1.0",
  "description": "Interactive terminal client for IncidentLens cloud investigations.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "incidentlens": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "npm run protocol:check && npm run typecheck && npm run build",
    "protocol:check": "npm run check --workspace @incidentlens/protocol",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:pty": "vitest run --config vitest.config.ts test/pty"
  },
  "dependencies": {
    "ink": "^6.8.0",
    "react": "^19.2.8",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^1.3.0"
  },
  "devDependencies": {
    "@incidentlens/protocol": "0.1.0",
    "@types/react": "^19.2.18",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "node-pty": "^1.1.0"
  }
}
