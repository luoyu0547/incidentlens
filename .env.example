INCIDENTLENS_DATA_DIR=.incidentlens-data
INCIDENTLENS_SECRET_PROVIDER=vault
INCIDENTLENS_TARGET_CATALOG=./data/targets.json

# OpenAI-compatible Chat Completions provider. Never commit a real API key.
INCIDENTLENS_AGENT_MODE=llm_agent
INCIDENTLENS_LLM_BASE_URL=https://api.deepseek.com
INCIDENTLENS_LLM_ACTIVE_MODEL=deepseek-v4-flash
INCIDENTLENS_LLM_API_KEY=replace-with-provider-api-key
